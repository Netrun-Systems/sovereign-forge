# Variable NAMES ONLY. Values are never committed.
# scripts/gen-env.sh reads this file, keeps anything already set in the target
# .env, takes values from your shell environment, and generates the secrets.
# Each name below is documented in ARCHITECTURE.md ("Configuration surface").

# --- identity and URLs
FORGE_HOST=
FORGE_ROOT_URL=
ADMIN_USER=
ADMIN_EMAIL=

# --- topology switches
CI_ENGINE=
WITH_CADDY=
CADDYFILE=
COMPOSE_PROFILES=
HTTP_BIND=
SSH_PUBLIC_PORT=
DATA_DIR=

# --- database
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- forgejo
FORGEJO_SECRET_KEY=

# --- forgejo actions runner
RUNNER_NAME=
RUNNER_LABELS=

# --- jenkins (only read when CI_ENGINE=jenkins)
JENKINS_HOST=
JENKINS_HEAP=
