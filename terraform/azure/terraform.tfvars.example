# Copy to terraform.tfvars (git-ignored) and fill in. Nothing here is a secret:
# these are your own names and PUBLIC keys.
location    = "eastus2"
forge_host  = "forge.example.com"
admin_email = "you@example.com"

# Single machine: Forgejo + Actions runner. Set vm_size = "Standard_B2s" for Jenkins.
ci_engine = "forgejo"

# The line from your id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAA...replace-with-your-public-key you@host"

# Your own address only (find it with: curl -s https://checkip.amazonaws.com)
admin_cidrs = ["198.51.100.10/32"]

# Output of:  age-keygen -o identity.txt   then   age-keygen -y identity.txt
# Keep identity.txt OFF the forge host and out of this repository.
age_recipient = "age1...replace-with-your-public-recipient"
