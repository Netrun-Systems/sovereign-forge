[Unit]
Description=Forge encrypted backup (tar -> age -> object storage -> read back -> prune)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/forge/backup.env
ExecStart=/opt/forge/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=4h
NoNewPrivileges=true
PrivateTmp=true
